# =============================================
# AfriMarket Backend - Variables d'environnement
# =============================================
# Copier ce fichier en .env et remplir les valeurs.
# Ne JAMAIS committer le fichier .env (il est ignoré par Git).
# Le serveur refuse de démarrer si JWT_SECRET ou DATABASE_URL sont invalides.

# ===== SERVEUR =====
NODE_ENV=development
PORT=3000
# 127.0.0.1 = accessible seulement depuis ce PC (l'émulateur Android passe par 10.0.2.2)
HOST=127.0.0.1

# ===== BASE DE DONNÉES =====
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5434/afrimarket?schema=public"

# ===== JWT =====
# Au moins 32 caractères aléatoires. Pour en générer un :
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_SECRET=""

# ===== CORS : origines web autorisées =====
# Liste séparée par des virgules (https://domaine, sans « / » final).
# Les applications mobiles ne sont pas concernées par le CORS.
# Si vide : CLIENT_URL et ADMIN_DASHBOARD_URL sont utilisées.
CORS_ORIGINS=
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
ADMIN_DASHBOARD_URL=http://localhost:5173

# ===== EMAIL : Mailtrap (développement) =====
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=
MAILTRAP_PASSWORD=
MAILTRAP_FROM_EMAIL=noreply@afrimarket.com

# ===== EMAIL : SMTP (production) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="AfriMarket <noreply@afrimarket.com>"
# Destinataires des alertes admin, séparés par des virgules
ADMIN_EMAILS=

# ===== SMS =====
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
AFRICAS_TALKING_API_KEY=

# ===== FIREBASE (notifications push) =====
# Fichier de compte de service : à garder hors du dépôt (déjà ignoré par Git)
FIREBASE_SERVICE_ACCOUNT_PATH=config/firebase-service-account.json
FIREBASE_PROJECT_ID=

# ===== reCAPTCHA =====
RECAPTCHA_SECRET_KEY=

# ===== KYC (vérification d'identité) =====
# Décision automatique (approbation/rejet sans humain). Laisser à false tant
# qu'aucune détection du vivant réelle n'est configurée : tout part en revue manuelle.
KYC_AUTO_DECISION_ENABLED=false
FACE_API_PROVIDER=
FACE_API_KEY=
FACE_API_SECRET=
FACE_API_ENDPOINT=
