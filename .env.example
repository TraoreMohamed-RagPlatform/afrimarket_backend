# ==========================================
# AfriMarket Backend - Environment Variables
# ==========================================

# ===== DATABASE =====
DATABASE_URL="postgresql://user:password@localhost:5432/afrimarket"

# ===== SERVER =====
PORT=3000
HOST=localhost
NODE_ENV=development

# ===== JWT =====
JWT_SECRET="votre_clé_secrète_jwt_très_longue_et_sécurisée_min_32_chars"
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# ===== EMAIL (Optionnel) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre_email@gmail.com
SMTP_PASSWORD=votre_mot_de_passe_app
SMTP_FROM="noreply@afrimarket.com"

# ===== FRONTEND (CORS) =====
FRONTEND_URL=http://localhost:3000

# ===== LOGGING =====
LOG_LEVEL=info