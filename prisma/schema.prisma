// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  password  String
  fullName  String
  phone     String?
  avatar    String?
  bio       String?
  location  String?
  role      String   @default("USER")
  status    String   @default("ACTIVE")
  verifiedEmail Boolean  @default(false)
  verifiedPhone Boolean  @default(false)
  avgRating     Float?   @default(0)
  totalRatings  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Identité vérifiée (KYC)
  identityVerification  IdentityVerification?
  isIdentityVerified    Boolean  @default(false)
  verifiedAt            DateTime?
  trustScore            Int      @default(50)

  listings        Listing[]
  messages        Message[]
  ratings         Rating[]
  sellerRatings   Rating[] @relation("seller")
  favorites       Favorite[]
  notifications   Notification[]
  fcmTokens       FCMToken[]
  verifications   Verification[]
  contactForms    ContactForm[]
  supportTickets  SupportTicket[]
  adminReports    AdminReport[]
  passwordResets  PasswordReset[]


  @@index([email])
  @@index([username])
  @@index([status])
  @@index([isIdentityVerified])
}

model Listing {
  id          String   @id @default(cuid())
  title       String
  description String
  price       Float
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  condition   String
  isSold      Boolean  @default(false)
  searchKeywords String[]  @default([])
  status      String   @default("ACTIVE")
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images        Image[]
  messages      Message[]
  ratings       Rating[]
  favorites     Favorite[]
  notifications Notification[]

  @@index([userId])
  @@index([categoryId])
  @@index([status])
  @@index([createdAt])
}

model Image {
  id        String   @id @default(cuid())
  url       String
  publicId  String?
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([listingId])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  listings    Listing[]
  createdAt   DateTime @default(now())

  @@index([slug])
}

model Message {
  id              String   @id @default(cuid())
  content         String
  senderId        String
  sender          User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  // Pour les messages privés
  conversationId  String?
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Pour les commentaires sur annonces
  listingId       String?
  listing         Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())

  @@index([senderId])
  @@index([conversationId])
  @@index([listingId])
  @@index([createdAt])
}

model Conversation {
  id              String   @id @default(cuid())
  participants    String[]
  lastMessageAt   DateTime?
  createdAt       DateTime @default(now())
  messages        Message[]

  @@index([createdAt])
}

model Rating {
  id        String   @id @default(cuid())
  score     Int
  comment   String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    User     @relation(fields: [sellerId], references: [id], onDelete: Cascade, name: "seller")
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId])
  @@index([sellerId])
  @@index([listingId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
}

model Notification {
  id        String   @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  read      Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model Verification {
  id        String   @id @default(cuid())
  type      VerificationType
  value     String
  code      String
  verified  Boolean  @default(false)
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, type])
  @@index([userId])
  @@index([verified])
  @@index([expiresAt])
}

model PasswordReset {
  id        String   @id @default(cuid())
  code      String
  used      Boolean  @default(false)
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model FCMToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  deviceName String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ContactForm {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  category  String   // bug, feature, question, other
  status    String   @default("OPEN") // OPEN, CLOSED, IN_PROGRESS
  response  String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([userId])
  @@index([createdAt])
}

model SupportTicket {
  id          String   @id @default(cuid())
  ticketNumber String  @unique // TK-001, TK-002, etc
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String
  status      String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  response    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model FAQ {
  id        String   @id @default(cuid())
  category  String   // account, listings, messaging, payments, other
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([order])
}

model AdminReport {
  id          String   @id @default(cuid())
  title       String
  type        String   // USERS, LISTINGS, SALES, SUPPORT, REVENUE, etc
  description String?
  filters     Json     // Contient les critères de filtre {dateRange, status, category, etc}
  data        Json     // Contient les données du rapport
  generatedBy String
  user        User     @relation(fields: [generatedBy], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([generatedBy])
  @@index([createdAt])
}

model IdentityVerification {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Informations du document
  documentType          String   // "NATIONAL_ID" | "PASSPORT" | "DRIVER_LICENSE"
  documentNumber        String   // Numéro du document
  documentCountry       String   // Pays d'émission (code ISO: MA, SN, etc)
  documentIssueDate     DateTime?
  documentExpiryDate    DateTime?

  // Images du document
  documentFrontImage    String   // chemin du fichier
  documentBackImage     String   // chemin du fichier

  // Biométrie / Selfie
  selfiePhoto           String   // chemin du fichier
  faceSimilarityScore   Float?   // Score de similarité visage (0-100)

  // Métadonnées de vérification
  status                String   @default("PENDING") // "PENDING" | "VERIFIED" | "REJECTED" | "EXPIRED"
  verificationMethod    String?  // "MANUAL" | "AUTOMATED"

  // Raison du rejet
  rejectionReason       String?  // "DOCUMENT_UNCLEAR" | "DOCUMENT_EXPIRED" | "FACE_MISMATCH" | "DOCUMENT_INVALID" | "OTHER"
  rejectionDetails      String?  // Détails additionnels

  // Admin verification
  verifiedBy            String?  // userId de l'admin qui a vérifié
  verificationNotes     String?  // Notes de l'admin
  verifiedAt            DateTime? // Quand c'est vérifié

  // Audit trail
  lastReviewedAt        DateTime?
  reviewCount           Int      @default(0)

  // Timestamps
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  expiresAt             DateTime? // Vérification expire après X jours

  @@index([userId])
  @@index([status])
  @@index([documentType])
  @@index([createdAt])
  @@index([expiresAt])
}

enum NotificationType {
  MESSAGE
  LISTING_INTEREST
  RATING_RECEIVED
  LISTING_SOLD
  LISTING_UPDATED
  SYSTEM
}

enum VerificationType {
  EMAIL
  PHONE
}
