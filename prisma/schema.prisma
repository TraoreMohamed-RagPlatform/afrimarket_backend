// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  password  String
  fullName  String
  phone     String?
  avatar    String?
  bio       String?
  location  String?
  role      String   @default("USER")
  status    String   @default("ACTIVE")
  verifiedEmail Boolean  @default(false)
  verifiedPhone Boolean  @default(false)
  avgRating     Float?   @default(0)
  totalRatings  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Identité vérifiée (KYC)
  identityVerification  IdentityVerification?
  isIdentityVerified    Boolean  @default(false)
  verifiedAt            DateTime?
  trustScore            Int      @default(50)

  // Temps de réponse habituel aux messages (moyenne glissante, en minutes).
  // Affiché seulement à partir de quelques réponses (voir services/responseTime.js).
  responseTimeMinutes   Int?
  responseSampleCount   Int      @default(0)

  settings        UserSettings?
  listingReports  ListingReport[]

  listings        Listing[]
  messages        Message[]
  buyerConversations  Conversation[] @relation("conversationBuyer")
  sellerConversations Conversation[] @relation("conversationSeller")
  ratings         Rating[]
  sellerRatings   Rating[] @relation("seller")
  favorites       Favorite[]
  notifications   Notification[]
  fcmTokens       FCMToken[]
  verifications   Verification[]
  contactForms    ContactForm[]
  supportTickets  SupportTicket[]
  adminReports    AdminReport[]
  passwordResets  PasswordReset[]
  refreshTokens   RefreshToken[]


  @@index([email])
  @@index([username])
  @@index([status])
  @@index([isIdentityVerified])
}

model Listing {
  id          String   @id @default(cuid())
  title       String
  description String
  price       Float
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  condition   String
  isSold      Boolean  @default(false)
  searchKeywords String[]  @default([])
  // ACTIVE, RESERVED (réservée, toujours visible), SOLD, INACTIVE
  status      String   @default("ACTIVE")
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  views       Int      @default(0)

  // Lieu : identifiants des listes fixes de src/config/listingOptions.js.
  city          String   @default("casablanca")
  district      String?
  isNegotiable  Boolean  @default(false)
  // Prix avant la dernière baisse (barré dans l'app). Rempli par le serveur.
  previousPrice Float?
  // PICKUP (main propre), DELIVERY (livraison) ou BOTH.
  deliveryMode  String   @default("PICKUP")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images        Image[]
  reports       ListingReport[]
  conversations Conversation[]
  ratings       Rating[]
  favorites     Favorite[]
  notifications Notification[]

  @@index([userId])
  @@index([categoryId])
  @@index([status])
  @@index([createdAt])
  @@index([city, district])
}

model Image {
  id        String   @id @default(cuid())
  url       String
  publicId  String?
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  // Ordre d'affichage : 0 = photo principale.
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([listingId])
  @@index([listingId, position])
}

// Paramètres de l'utilisateur. Absents = valeurs par défaut.
// Le numéro n'est jamais montré sans consentement explicite (showPhone).
model UserSettings {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  showPhone       Boolean  @default(false)
  whatsappEnabled Boolean  @default(false)
  messageAlerts   Boolean  @default(true)
  listingAlerts   Boolean  @default(true)
  ratingAlerts    Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

// Signalement d'une annonce par un utilisateur (un seul par annonce et par personne).
model ListingReport {
  id          String   @id @default(cuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporterId  String
  reporter    User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason      String   // voir REPORT_REASONS
  details     String?
  status      String   @default("OPEN") // OPEN, REVIEWED, DISMISSED
  createdAt   DateTime @default(now())

  @@unique([listingId, reporterId])
  @@index([reporterId])
  @@index([status])
  @@index([createdAt])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  // Ordre d'affichage (menu « Catégories ») : plus petit d'abord.
  position    Int      @default(0)
  listings    Listing[]
  createdAt   DateTime @default(now())

  @@index([slug])
  @@index([position])
}

model Message {
  id              String   @id @default(cuid())
  // Texte seul, 1 à 1000 caractères (vérifié par la route).
  content         String
  senderId        String
  sender          User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Lu par le destinataire (null : non lu). Rempli à l'ouverture de la conversation.
  readAt          DateTime?
  createdAt       DateTime @default(now())

  @@index([senderId])
  @@index([conversationId])
  @@index([conversationId, readAt])
  @@index([conversationId, createdAt])
  @@index([createdAt])
}

// Discussion entre un acheteur et le vendeur, à propos d'une annonce
// (comme Facebook Marketplace) : une seule par annonce et par acheteur.
model Conversation {
  id              String    @id @default(cuid())
  // Annonce supprimée : la discussion reste (« Annonce supprimée »).
  // Null aussi pour les discussions créées avant le lien avec l'annonce.
  listingId       String?
  listing         Listing?  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  buyerId         String
  buyer           User      @relation("conversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId        String
  seller          User      @relation("conversationSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  lastMessageAt   DateTime?
  createdAt       DateTime  @default(now())
  messages        Message[]

  @@unique([listingId, buyerId])
  @@index([buyerId, lastMessageAt])
  @@index([sellerId, lastMessageAt])
  @@index([createdAt])
}

model Rating {
  id        String   @id @default(cuid())
  score     Int
  comment   String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    User     @relation(fields: [sellerId], references: [id], onDelete: Cascade, name: "seller")
  // Annonce supprimée : l'avis reste (comme sur Marketplace), sinon un
  // vendeur effacerait ses mauvaises notes en supprimant l'annonce.
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId])
  @@index([sellerId])
  @@index([listingId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
}

model Notification {
  id        String   @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  read      Boolean  @default(false)
  // Vue (onglet Notifications ouvert) : la pastille ne la compte plus,
  // même si elle n'a pas été touchée (« read »). Comme Facebook.
  seenAt    DateTime?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@index([userId, read])
  @@index([userId, seenAt])
  @@index([userId, createdAt])
}

model Verification {
  id        String   @id @default(cuid())
  type      VerificationType
  value     String
  code      String
  verified  Boolean  @default(false)
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, type])
  @@index([userId])
  @@index([verified])
  @@index([expiresAt])
}

model PasswordReset {
  id        String   @id @default(cuid())
  code      String
  used      Boolean  @default(false)
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Jetons de rafraîchissement (sessions). Seule l'empreinte SHA-256 est stockée :
// une fuite de la base ne donne aucun jeton utilisable.
// Rotation à chaque usage ; un jeton déjà utilisé révoque toute sa famille.
model RefreshToken {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash        String    @unique
  familyId         String
  sessionStartedAt DateTime
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedById     String?
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model FCMToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  deviceName String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ContactForm {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  category  String   // bug, feature, question, other
  status    String   @default("OPEN") // OPEN, CLOSED, IN_PROGRESS
  response  String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([userId])
  @@index([createdAt])
}

model SupportTicket {
  id          String   @id @default(cuid())
  ticketNumber String  @unique // TK-001, TK-002, etc
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String
  status      String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  response    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model FAQ {
  id        String   @id @default(cuid())
  category  String   // account, listings, messaging, payments, other
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([order])
}

model AdminReport {
  id          String   @id @default(cuid())
  title       String
  type        String   // USERS, LISTINGS, SALES, SUPPORT, REVENUE, etc
  description String?
  filters     Json     // Contient les critères de filtre {dateRange, status, category, etc}
  data        Json     // Contient les données du rapport
  generatedBy String
  user        User     @relation(fields: [generatedBy], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([generatedBy])
  @@index([createdAt])
}

model IdentityVerification {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Informations du document
  documentType          String   // "NATIONAL_ID" | "PASSPORT" | "DRIVER_LICENSE"
  documentNumber        String   // Numéro du document
  documentCountry       String   // Pays d'émission (code ISO: MA, SN, etc)
  documentIssueDate     DateTime?
  documentExpiryDate    DateTime?

  // Images du document
  documentFrontImage    String   // chemin du fichier
  documentBackImage     String   // chemin du fichier

  // Biométrie / Selfie
  selfiePhoto           String   // chemin du fichier
  faceSimilarityScore   Float?   // Score de similarité visage (0-100)

  // Métadonnées de vérification
  status                String   @default("PENDING") // "PENDING" | "VERIFIED" | "REJECTED" | "EXPIRED"
  verificationMethod    String?  // "MANUAL" | "AUTOMATED"

  // Raison du rejet
  rejectionReason       String?  // "DOCUMENT_UNCLEAR" | "DOCUMENT_EXPIRED" | "FACE_MISMATCH" | "DOCUMENT_INVALID" | "OTHER"
  rejectionDetails      String?  // Détails additionnels

  // Admin verification
  verifiedBy            String?  // userId de l'admin qui a vérifié
  verificationNotes     String?  // Notes de l'admin
  verifiedAt            DateTime? // Quand c'est vérifié

  // Audit trail
  lastReviewedAt        DateTime?
  reviewCount           Int      @default(0)

  // Timestamps
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  expiresAt             DateTime? // Vérification expire après X jours

  @@index([userId])
  @@index([status])
  @@index([documentType])
  @@index([createdAt])
  @@index([expiresAt])
}

enum NotificationType {
  MESSAGE
  LISTING_INTEREST
  RATING_RECEIVED
  LISTING_SOLD
  LISTING_UPDATED
  SYSTEM
}

enum VerificationType {
  EMAIL
  PHONE
}
